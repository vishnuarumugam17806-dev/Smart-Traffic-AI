# VIGITRA AI Environment Configuration Template

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vigitra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vigitra_db

# Security & Authentication
SECRET_KEY=vigitra_secret_key_change_in_production_2026_sih
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Domain & WebRTC Configuration
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
WEBSOCKET_BASE_URL=ws://localhost:8000/ws
TURN_SERVER_URL=stun:stun.l.google.com:19302
TURN_USERNAME=your_turn_username_here
TURN_CREDENTIAL=your_turn_credential_here

# Backend GIS & Map Settings
MAP_PROVIDER=CartoDB
MAP_API_KEY=your_backend_map_api_key_here
GEOCODING_API_KEY=your_geocoding_api_key_here
ROUTING_API_KEY=your_routing_api_key_here

# Frontend GIS Map Configuration (Exposed to Vite bundle)
VITE_MAP_PROVIDER=CartoDB
VITE_MAP_STYLE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_PUBLIC_KEY=your_frontend_map_public_key_here
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_FRONTEND_BASE_URL=http://localhost:5173
VITE_TURN_SERVER_URL=stun:stun.l.google.com:19302
